---
import { site } from '../data/site.js';

/**
 * Closing call to action. The default slot renders under the buttons — the
 * homepage uses it for the "which division?" quick links.
 */
const {
  title = 'Ready to start a conversation?',
  text = 'Tell us what you need and we will point you to the right division.',
  cta = 'Contact us',
  href = '/contact',
} = Astro.props;
---

<section class="on-dark bg-primary text-white">
  <div class="container-max py-20 md:py-28">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-x-12 gap-y-12 lg:items-end" data-reveal>
      <div class="lg:col-span-8">
        <p class="eyebrow eyebrow-rule mb-6">Get in touch</p>
        <h2 class="display-2 max-w-3xl">{title}</h2>
        <p class="lead mt-6 max-w-xl">{text}</p>
        <div class="flex flex-col sm:flex-row sm:flex-wrap sm:items-center gap-3 mt-9">
          <a href={href} class="btn-gold btn-arrow">{cta}</a>
          <a
            href={`https://wa.me/${site.contact.whatsapp}`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-outline-light"
          >
            Message on WhatsApp
          </a>
        </div>
        <slot />
      </div>

      <address class="lg:col-span-4 lg:justify-self-end text-[15px] leading-relaxed text-white/70">
        <p class="eyebrow text-white/50 mb-3">Direct</p>
        <p>
          <a href={`tel:${site.contact.phone}`} class="link-target text-white hover:text-secondary-fixed transition-colors duration-150">
            {site.contact.phoneDisplay}
          </a>
        </p>
        <p>
          <a href={`mailto:${site.contact.email}`} class="link-target text-white hover:text-secondary-fixed transition-colors duration-150 break-all">
            {site.contact.email}
          </a>
        </p>
        <p class="mt-3">{site.contact.address}<br />{site.contact.region}</p>
      </address>
    </div>
  </div>
</section>
