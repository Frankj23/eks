---
import { nav } from '../data/navigation.js';
import { site } from '../data/site.js';

const { activeSection } = Astro.props;
---

<!--
  CANONICAL HEADER — written once, used on every page.
  Menu contents come entirely from src/data/navigation.js.
  Do not hand-edit links here; edit the data file.
-->
<header id="site-header" class="site-header">
  <div class="container-max flex items-center justify-between h-full gap-6">
    <a href="/" class="brand shrink-0" aria-label={`${site.name} — home`}>{site.name}</a>

    <!-- ============ DESKTOP NAV ============ -->
    <nav id="desktop-nav" class="hidden lg:flex items-center h-full" aria-label="Main navigation">
      {
        nav.map((item) => (
          <div class="menu-item h-full flex items-center">
            <button
              type="button"
              class="menu-trigger"
              class:list={[activeSection === item.id && 'is-current']}
              aria-expanded="false"
              aria-controls={`panel-${item.id}`}
            >
              {item.label}
              <svg class="chevron" width="10" height="10" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path
                  d="M3 4.5L6 7.5L9 4.5"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>

            {/* ---- Full-width shelf under the header ---- */}
            <div id={`panel-${item.id}`} class="menu-panel">
              <div class="container-max grid grid-cols-12 gap-x-12 py-10 xl:py-12">
                <div class="col-span-4 pr-6">
                  <p class="heading-2 text-primary mb-3">{item.label}</p>
                  {item.blurb && (
                    <p class="text-[15px] text-on-surface-variant leading-relaxed max-w-xs mb-5">
                      {item.blurb}
                    </p>
                  )}
                  <a href={item.href} class="link-arrow">
                    {item.simple ? 'About the firm' : `${item.label} overview`}
                  </a>
                </div>
                <div class="col-span-8 flex gap-x-16 gap-y-8">
                  {item.columns.map((col) => (
                    <div class="min-w-0 flex-1 max-w-xs">
                      <p class="eyebrow text-on-surface-variant pb-3 mb-2 border-b border-outline-variant">
                        {col.heading ?? 'Explore'}
                      </p>
                      <ul>
                        {col.links.map((link) => (
                          <li>
                            <a href={link.href} class="menu-link">
                              {link.label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a href="/contact" class="btn-primary btn-sm hidden sm:inline-flex">Contact us</a>

      <!-- ============ HAMBURGER ============ -->
      <button
        type="button"
        id="drawer-open"
        class="icon-btn lg:hidden text-primary -mr-2.5"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-drawer"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 8h16M4 16h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Dims the page while a desktop shelf is open -->
<div id="menu-scrim" class="menu-scrim" aria-hidden="true"></div>

<!-- ============ MOBILE DRAWER ============ -->
<div id="drawer-overlay" class="drawer-overlay lg:hidden" aria-hidden="true"></div>

<aside
  id="mobile-drawer"
  class="drawer lg:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation menu"
  inert
>
  <div class="drawer-bar">
    <a href="/" class="brand">{site.name}</a>
    <button type="button" id="drawer-close" class="icon-btn text-primary -mr-2.5" aria-label="Close navigation menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <nav class="flex-1 overflow-y-auto overscroll-contain px-5 pt-2 pb-6" aria-label="Mobile navigation">
    {
      nav.map((item, i) => (
        <div class="border-b border-outline-variant">
          <button
            type="button"
            class="accordion-trigger"
            aria-expanded="false"
            aria-controls={`drawer-panel-${item.id}`}
          >
            <span class="flex items-baseline gap-4">
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <span class="drawer-label">{item.label}</span>
            </span>
            <span class="faq-icon" aria-hidden="true" />
          </button>
          <div id={`drawer-panel-${item.id}`} class="accordion-panel">
            <div class="pl-9 pb-4">
              <a href={item.href} class="drawer-link font-medium !text-primary">
                {item.simple ? 'About us' : `${item.label} overview`}
              </a>
              {item.columns.map((col) => (
                <>
                  {col.heading && <p class="eyebrow text-on-surface-variant mt-4 mb-1">{col.heading}</p>}
                  {col.links
                    .filter((link) => link.href !== item.href)
                    .map((link) => (
                      <a href={link.href} class="drawer-link">
                        {link.label}
                      </a>
                    ))}
                </>
              ))}
            </div>
          </div>
        </div>
      ))
    }
  </nav>

  <div class="drawer-foot">
    <a href="/contact" class="btn-primary btn-arrow w-full">Contact us</a>
    <div class="flex items-center justify-between mt-4 text-sm text-on-surface-variant">
      <a href={`tel:${site.contact.phone}`} class="link-target">{site.contact.phoneDisplay}</a>
      <a
        href={`https://wa.me/${site.contact.whatsapp}`}
        target="_blank"
        rel="noopener noreferrer"
        class="link-target link">WhatsApp</a
      >
    </div>
  </div>
</aside>

<!-- Spacer so page content clears the fixed header -->
<div style="height: var(--header-h)" aria-hidden="true"></div>

<script>
  const header = document.getElementById('site-header');
  const desktopNav = document.getElementById('desktop-nav');
  const scrim = document.getElementById('menu-scrim');

  // ---------- HEADER SURFACE ----------
  // The hairline under the header only appears once content scrolls beneath it.
  const onScroll = () => header?.toggleAttribute('data-scrolled', window.scrollY > 4);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // ---------- DESKTOP MEGA-MENU ----------
  // Opens on hover and on click/keyboard, closes on Escape, outside click and
  // when focus leaves. Moving between triggers while a shelf is open swaps the
  // content instantly — only the first open and the final close animate.
  const items = [...document.querySelectorAll<HTMLElement>('.menu-item')];
  let current: HTMLElement | null = null;
  let openTimer: ReturnType<typeof setTimeout> | undefined;
  let closeTimer: ReturnType<typeof setTimeout> | undefined;

  const parts = (item: HTMLElement) => ({
    panel: item.querySelector<HTMLElement>('.menu-panel'),
    trigger: item.querySelector<HTMLElement>('.menu-trigger'),
  });

  function setOpen(item: HTMLElement, open: boolean) {
    const { panel, trigger } = parts(item);
    if (!panel || !trigger) return;
    panel.classList.toggle('is-open', open);
    trigger.setAttribute('aria-expanded', String(open));
  }

  function openPanel(item: HTMLElement, instant = false) {
    clearTimeout(closeTimer);
    if (current === item) return;
    // A swap, or a keyboard-initiated open, must not make the user wait.
    desktopNav?.toggleAttribute('data-instant', instant || current !== null);
    if (current) setOpen(current, false);
    setOpen(item, true);
    current = item;
    header?.setAttribute('data-menu-open', '');
    scrim?.classList.add('is-open');
  }

  function closeAll(instant = false) {
    clearTimeout(openTimer);
    if (!current) return;
    desktopNav?.toggleAttribute('data-instant', instant);
    setOpen(current, false);
    current = null;
    header?.removeAttribute('data-menu-open');
    scrim?.classList.remove('is-open');
  }

  items.forEach((item) => {
    const { trigger } = parts(item);

    item.addEventListener('mouseenter', () => {
      clearTimeout(closeTimer);
      clearTimeout(openTimer);
      // Brief intent delay on the first open so a pointer crossing the header
      // on its way elsewhere does not drop a shelf over the page.
      if (current) openPanel(item);
      else openTimer = setTimeout(() => openPanel(item), 70);
    });
    item.addEventListener('mouseleave', () => {
      clearTimeout(openTimer);
      closeTimer = setTimeout(() => closeAll(), 140);
    });

    trigger?.addEventListener('click', (e) => {
      // detail === 0 means the click came from the keyboard.
      const fromKeyboard = e.detail === 0;
      if (current === item) closeAll(fromKeyboard);
      else openPanel(item, fromKeyboard);
    });

    item.addEventListener('focusout', (e) => {
      const next = e.relatedTarget as Node | null;
      if (current === item && next && !item.contains(next)) closeAll(true);
    });
  });

  document.addEventListener('click', (e) => {
    if (current && !current.contains(e.target as Node)) closeAll();
  });

  // ---------- MOBILE DRAWER ----------
  const drawer = document.getElementById('mobile-drawer');
  const overlay = document.getElementById('drawer-overlay');
  const openBtn = document.getElementById('drawer-open');
  const closeBtn = document.getElementById('drawer-close');
  const isDrawerOpen = () => drawer?.classList.contains('is-open') ?? false;

  function openDrawer() {
    if (!drawer) return;
    drawer.removeAttribute('inert');
    drawer.classList.add('is-open');
    overlay?.classList.add('is-open');
    openBtn?.setAttribute('aria-expanded', 'true');
    document.documentElement.style.overflow = 'hidden'; // lock background scroll
    closeBtn?.focus({ preventScroll: true });
  }

  function closeDrawer() {
    if (!drawer) return;
    drawer.classList.remove('is-open');
    drawer.setAttribute('inert', '');
    overlay?.classList.remove('is-open');
    openBtn?.setAttribute('aria-expanded', 'false');
    document.documentElement.style.overflow = '';
    openBtn?.focus({ preventScroll: true });
  }

  openBtn?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  overlay?.addEventListener('click', closeDrawer);

  // Keep Tab inside the drawer while it is open.
  drawer?.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab') return;
    const focusable = [
      ...drawer.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'),
    ].filter((el) => el.offsetParent !== null && getComputedStyle(el).visibility !== 'hidden');
    if (focusable.length === 0) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });

  // Crossing into the desktop layout with the drawer open would strand the
  // scroll lock on a drawer that is no longer rendered.
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
    if (e.matches && isDrawerOpen()) closeDrawer();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (isDrawerOpen()) {
      closeDrawer();
    } else if (current) {
      const { trigger } = parts(current);
      const hadFocus = current.contains(document.activeElement);
      closeAll(true);
      if (hadFocus) trigger?.focus();
    }
  });

  // ---------- MOBILE ACCORDIONS ----------
  // One section open at a time.
  const triggers = document.querySelectorAll<HTMLElement>('.accordion-trigger');
  triggers.forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';

      triggers.forEach((other) => {
        other.setAttribute('aria-expanded', 'false');
        (other.nextElementSibling as HTMLElement | null)?.classList.remove('is-open');
      });

      if (!isOpen) {
        trigger.setAttribute('aria-expanded', 'true');
        (trigger.nextElementSibling as HTMLElement | null)?.classList.add('is-open');
      }
    });
  });
</script>

<style>
  /* ---------- Bar ---------- */
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: var(--header-h);
    /* Near-opaque: enough blur to feel like glass over paper, not enough
       transparency to turn muddy when a navy section passes underneath. */
    background-color: rgb(246 244 238 / 0.94);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid transparent;
    transition:
      border-color 200ms ease,
      background-color 200ms ease;
  }
  .site-header[data-scrolled] {
    border-bottom-color: var(--color-outline-variant);
  }
  /* Opaque while a shelf is open so bar and shelf read as one surface. */
  .site-header[data-menu-open] {
    background-color: var(--color-background);
    border-bottom-color: var(--color-outline-variant);
  }

  .brand {
    font-family: var(--font-display);
    font-size: 1.4375rem;
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1;
    color: var(--color-primary);
    padding-block: 10px;
  }

  /* ---------- Desktop triggers ---------- */
  .menu-trigger {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 100%;
    padding-inline: 14px;
    font-size: 0.90625rem;
    font-weight: 500;
    letter-spacing: -0.006em;
    white-space: nowrap;
    color: var(--color-on-surface-variant);
    cursor: pointer;
    transition: color var(--duration-hover) ease;
  }
  .menu-trigger:hover,
  .menu-trigger[aria-expanded='true'],
  .menu-trigger.is-current {
    color: var(--color-primary);
  }
  /* Current-section marker: a brass hairline sitting on the header edge */
  .menu-trigger::after {
    content: '';
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: -1px;
    height: 2px;
    background-color: var(--color-secondary);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 240ms var(--ease-emphasized);
  }
  .menu-trigger.is-current::after,
  .menu-trigger[aria-expanded='true']::after {
    transform: scaleX(1);
  }
  .chevron {
    opacity: 0.6;
    transition: transform 200ms var(--ease-emphasized);
  }
  .menu-trigger[aria-expanded='true'] .chevron {
    transform: rotate(180deg);
  }

  /* ---------- Shelf ---------- */
  .menu-panel {
    position: fixed;
    left: 0;
    right: 0;
    top: var(--header-h);
    max-height: calc(100dvh - var(--header-h));
    overflow-y: auto;
    background-color: var(--color-background);
    border-bottom: 1px solid var(--color-outline-variant);
    box-shadow: 0 28px 48px -28px rgb(6 21 43 / 0.22);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    /* Exit is quicker than entry: the system responding, not the user deciding */
    transition:
      opacity 130ms ease,
      transform 130ms ease,
      visibility 0s linear 130ms;
  }
  .menu-panel.is-open {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 180ms ease,
      transform 220ms var(--ease-emphasized),
      visibility 0s;
  }
  [data-instant] .menu-panel,
  [data-instant] .menu-panel.is-open {
    transition: none;
  }

  .menu-link {
    display: flex;
    align-items: center;
    min-height: 36px;
    padding-block: 6px;
    font-size: 0.9375rem;
    line-height: 1.35;
    color: var(--color-on-surface);
    transition: color 150ms ease;
  }
  .menu-link:hover {
    color: var(--color-secondary);
  }

  .menu-scrim {
    position: fixed;
    inset: 0;
    z-index: 45;
    background-color: rgb(6 21 43 / 0.28);
    opacity: 0;
    pointer-events: none;
    transition: opacity 180ms ease;
  }
  .menu-scrim.is-open {
    opacity: 1;
  }

  /* ---------- Drawer ---------- */
  .drawer-overlay {
    position: fixed;
    inset: 0;
    z-index: 60;
    background-color: rgb(6 21 43 / 0.5);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 220ms ease,
      visibility 0s linear 220ms;
  }
  .drawer-overlay.is-open {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 320ms ease,
      visibility 0s;
  }

  .drawer {
    position: fixed;
    top: 0;
    right: 0;
    z-index: 70;
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 26rem;
    height: 100dvh;
    background-color: var(--color-background);
    visibility: hidden;
    transform: translateX(100%);
    transition:
      transform 240ms var(--ease-drawer),
      visibility 0s linear 240ms;
  }
  .drawer.is-open {
    visibility: visible;
    transform: none;
    transition:
      transform 420ms var(--ease-drawer),
      visibility 0s;
  }
  .drawer-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex: none;
    height: var(--header-h);
    padding-inline: 20px;
    border-bottom: 1px solid var(--color-outline-variant);
  }
  .drawer-foot {
    flex: none;
    padding: 16px 20px max(20px, env(safe-area-inset-bottom));
    border-top: 1px solid var(--color-outline-variant);
  }

  .accordion-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 64px;
    padding-block: 14px;
    text-align: left;
    cursor: pointer;
  }
  .drawer-label {
    font-family: var(--font-display);
    font-size: 1.625rem;
    line-height: 1.1;
    letter-spacing: -0.022em;
    color: var(--color-primary);
  }
  /* The +/− glyph is shared with the FAQ; here state rides on aria-expanded. */
  .accordion-trigger[aria-expanded='true'] .faq-icon::after {
    transform: rotate(0deg);
    opacity: 0;
  }
  .drawer-link {
    display: flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.9375rem;
    color: var(--color-on-surface-variant);
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-panel,
    .drawer {
      transform: none;
    }
  }
</style>
