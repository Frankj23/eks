---
import { nav } from '../data/navigation.js';
import { site } from '../data/site.js';

const { activeSection } = Astro.props;
---

<!--
  CANONICAL HEADER — written once, used on every page.
  Menu contents come entirely from src/data/navigation.js.
  Do not hand-edit links here; edit the data file.
-->
<header
  id="site-header"
  class="fixed top-0 left-0 w-full z-50 bg-background border-b border-outline-variant"
>
  <!-- Full-bleed bar; only the inner content is capped at 1280px.
       (The old build capped the fixed element itself, so the border stopped
       short of the screen edge on wide monitors.) -->
  <div class="container-max flex items-center justify-between h-20">
    <a href="/" class="font-display font-bold text-xl text-primary shrink-0">
      {site.name}
    </a>

    <!-- ============ DESKTOP NAV ============ -->
    <nav class="hidden lg:flex items-center h-full" aria-label="Main navigation">
      {
        nav.map((item) => (
          <div class="menu-item relative h-full flex items-center">
            <button
              type="button"
              class="menu-trigger flex items-center gap-1.5 h-full px-3 xl:px-4 eyebrow whitespace-nowrap transition-colors"
              class:list={[
                activeSection === item.id
                  ? 'text-primary'
                  : 'text-on-surface-variant hover:text-secondary',
              ]}
              aria-expanded="false"
              aria-controls={`panel-${item.id}`}
            >
              {item.label}
              <svg
                class="chevron w-3 h-3 transition-transform duration-200"
                viewBox="0 0 12 12"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M3 4.5L6 7.5L9 4.5"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              {activeSection === item.id && (
                <span class="absolute bottom-0 left-3 right-3 xl:left-4 xl:right-4 h-0.5 bg-secondary" />
              )}
            </button>

            {/* ---- Mega-menu panel ---- */}
            <div
              id={`panel-${item.id}`}
              class="menu-panel invisible opacity-0 top-20"
              class:list={[
                item.simple
                  ? 'absolute right-0 w-56'
                  : 'fixed left-1/2 -translate-x-1/2 w-max max-w-[min(56rem,calc(100vw-3rem))]',
              ]}
            >
              <div class="mt-0 bg-surface border border-outline-variant rounded-lg shadow-[0_12px_40px_rgb(0_0_0/0.12)] p-6">
                <div class="flex flex-wrap gap-x-10 gap-y-6">
                  {item.blurb && (
                    <div class="w-52 shrink-0 border-r border-outline-variant pr-8">
                      <p class="eyebrow text-secondary mb-2">{item.label}</p>
                      <p class="text-sm text-on-surface-variant leading-relaxed">
                        {item.blurb}
                      </p>
                      <a
                        href={item.href}
                        class="link-target mt-4 text-sm font-semibold text-primary hover:text-secondary transition-colors"
                      >
                        Overview →
                      </a>
                    </div>
                  )}
                  {item.columns.map((col) => (
                    <div class="min-w-48">
                      {col.heading && (
                        <p class="eyebrow text-on-surface-variant mb-3">
                          {col.heading}
                        </p>
                      )}
                      <ul class="space-y-2.5">
                        {col.links.map((link) => (
                          <li>
                            <a
                              href={link.href}
                              class="link-target text-sm text-on-surface hover:text-secondary transition-colors"
                            >
                              {link.label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a href="/contact" class="btn-primary hidden sm:inline-flex">Contact Us</a>

      <!-- ============ HAMBURGER ============ -->
      <button
        type="button"
        id="drawer-open"
        class="icon-btn lg:hidden text-primary"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-drawer"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M3 6h18M3 12h18M3 18h18"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- ============ MOBILE DRAWER ============ -->
<div
  id="drawer-overlay"
  class="fixed inset-0 bg-black/50 z-50 opacity-0 invisible transition-opacity duration-300 lg:hidden"
  aria-hidden="true"
>
</div>

<aside
  id="mobile-drawer"
  class="fixed top-0 right-0 h-dvh w-[88%] max-w-sm bg-surface z-50 translate-x-full transition-transform duration-300 ease-out lg:hidden flex flex-col"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation menu"
>
  <div
    class="flex items-center justify-between h-20 px-5 border-b border-outline-variant shrink-0"
  >
    <span class="font-display font-bold text-lg text-primary">{site.name}</span>
    <button
      type="button"
      id="drawer-close"
      class="icon-btn text-primary"
      aria-label="Close navigation menu"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M18 6L6 18M6 6l12 12"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <nav class="flex-1 overflow-y-auto px-5 py-4" aria-label="Mobile navigation">
    {
      nav.map((item) => (
        <div class="border-b border-outline-variant">
          <button
            type="button"
            class="accordion-trigger w-full flex items-center justify-between py-4 text-left"
            aria-expanded="false"
          >
            <span class="eyebrow text-primary">{item.label}</span>
            <svg
              class="chevron w-4 h-4 text-on-surface-variant transition-transform duration-200"
              viewBox="0 0 12 12"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M3 4.5L6 7.5L9 4.5"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>
          <div class="accordion-panel"><div class="pb-3">
            <a
              href={item.href}
              class="block py-3 text-sm font-semibold text-primary"
            >
              {item.label} Overview
            </a>
            {item.columns.map((col) => (
              <>
                {col.heading && (
                  <p class="eyebrow text-on-surface-variant mt-3 mb-1">
                    {col.heading}
                  </p>
                )}
                {col.links.map((link) => (
                  <a
                    href={link.href}
                    class="block py-3 text-sm text-on-surface-variant hover:text-secondary"
                  >
                    {link.label}
                  </a>
                ))}
              </>
            ))}
          </div></div>
        </div>
      ))
    }
  </nav>

  <div class="p-5 border-t border-outline-variant shrink-0">
    <a href="/contact" class="btn-primary w-full">Contact Us</a>
  </div>
</aside>

<!-- Spacer so page content clears the fixed 80px header -->
<div class="h-20" aria-hidden="true"></div>

<script>
  // ---------- DESKTOP MEGA-MENU ----------
  // Opens on hover and on click/focus, closes on Escape and outside click.
  const items = document.querySelectorAll<HTMLElement>('.menu-item');
  let openTimer: ReturnType<typeof setTimeout> | undefined;

  function openPanel(item: HTMLElement) {
    items.forEach((other) => other !== item && closePanel(other));
    const panel = item.querySelector<HTMLElement>('.menu-panel');
    const trigger = item.querySelector<HTMLElement>('.menu-trigger');
    const chevron = item.querySelector<HTMLElement>('.chevron');
    if (!panel || !trigger) return;
    panel.classList.remove('invisible', 'opacity-0');
    panel.classList.add('is-open');
    trigger.setAttribute('aria-expanded', 'true');
    chevron?.style.setProperty('transform', 'rotate(180deg)');
  }

  function closePanel(item: HTMLElement) {
    const panel = item.querySelector<HTMLElement>('.menu-panel');
    const trigger = item.querySelector<HTMLElement>('.menu-trigger');
    const chevron = item.querySelector<HTMLElement>('.chevron');
    if (!panel || !trigger) return;
    panel.classList.add('invisible', 'opacity-0');
    panel.classList.remove('is-open');
    trigger.setAttribute('aria-expanded', 'false');
    chevron?.style.removeProperty('transform');
  }

  items.forEach((item) => {
    const trigger = item.querySelector<HTMLElement>('.menu-trigger');

    item.addEventListener('mouseenter', () => {
      clearTimeout(openTimer);
      openPanel(item);
    });
    item.addEventListener('mouseleave', () => {
      openTimer = setTimeout(() => closePanel(item), 120);
    });

    trigger?.addEventListener('click', (e) => {
      e.preventDefault();
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';
      isOpen ? closePanel(item) : openPanel(item);
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      items.forEach(closePanel);
      if (drawer?.classList.contains('translate-x-0')) closeDrawer();
    }
  });

  document.addEventListener('click', (e) => {
    const target = e.target as Node;
    items.forEach((item) => {
      if (!item.contains(target)) closePanel(item);
    });
  });

  // ---------- MOBILE DRAWER ----------
  const drawer = document.getElementById('mobile-drawer');
  const overlay = document.getElementById('drawer-overlay');
  const openBtn = document.getElementById('drawer-open');
  const closeBtn = document.getElementById('drawer-close');

  function openDrawer() {
    drawer?.classList.remove('translate-x-full');
    drawer?.classList.add('translate-x-0');
    overlay?.classList.remove('opacity-0', 'invisible');
    openBtn?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden'; // lock background scroll
    closeBtn?.focus();
  }

  function closeDrawer() {
    drawer?.classList.add('translate-x-full');
    drawer?.classList.remove('translate-x-0');
    overlay?.classList.add('opacity-0', 'invisible');
    openBtn?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    openBtn?.focus();
  }

  openBtn?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  overlay?.addEventListener('click', closeDrawer);

  // ---------- MOBILE ACCORDIONS ----------
  // One section open at a time.
  document.querySelectorAll<HTMLElement>('.accordion-trigger').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const panel = trigger.nextElementSibling as HTMLElement | null;
      const chevron = trigger.querySelector<HTMLElement>('.chevron');
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';

      document.querySelectorAll<HTMLElement>('.accordion-trigger').forEach((other) => {
        other.setAttribute('aria-expanded', 'false');
        (other.nextElementSibling as HTMLElement)?.classList.remove('is-open');
        other.querySelector<HTMLElement>('.chevron')?.style.removeProperty('transform');
      });

      if (!isOpen) {
        trigger.setAttribute('aria-expanded', 'true');
        panel?.classList.add('is-open');
        chevron?.style.setProperty('transform', 'rotate(180deg)');
      }
    });
  });
</script>

<style>
  /* Base (no-hover / touch) transition. The hover-capable refinement with the
     translateY origin lives in global.css behind a (hover: hover) query. */
  .menu-panel {
    transition:
      opacity 0.18s ease,
      visibility 0.18s ease;
  }
</style>
