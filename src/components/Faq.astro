---
/**
 * Accordion of questions. `items` is [{ q, a }].
 * Native <details>, so it works without JavaScript; the open/close motion is
 * defined once in global.css (`details.faq`).
 */
const { items = [] } = Astro.props;
---

<div class="rule-list">
  {
    items.map((f) => (
      <details class="faq">
        <summary class="flex items-center justify-between gap-6 py-6 min-h-[44px]">
          <span class="heading-3">{f.q}</span>
          <span class="faq-icon" aria-hidden="true" />
        </summary>
        <p class="pb-7 pr-10 max-w-2xl text-on-surface-variant leading-relaxed">{f.a}</p>
      </details>
    ))
  }
</div>
