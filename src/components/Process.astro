---
/**
 * Numbered sequence of steps: a horizontal timeline on desktop, a vertical
 * one on phones. `steps` is [{ title, text }].
 *
 * The connecting hairline draws itself once when the row scrolls into view —
 * it is the one thing on the page that explains order, so it earns the motion.
 */
const { steps = [] } = Astro.props;
---

<div class="process" style={`--steps: ${steps.length}`} data-reveal data-reveal-keep>
  <span class="process-line" data-reveal-line aria-hidden="true"></span>
  <ol class="process-grid">
    {
      steps.map((step, i) => (
        <li class="process-step">
          <span class="process-node" aria-hidden="true" />
          <span class="num block mb-3">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="heading-3 mb-2.5">{step.title}</h3>
          <p class="text-[15px] leading-relaxed text-on-surface-variant max-w-xs">{step.text}</p>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .process {
    position: relative;
    padding-left: 1.75rem;
  }
  .process-grid {
    display: grid;
    gap: 2.25rem;
  }
  .process-step {
    position: relative;
  }
  /* Phones and tablets: the line runs down the left edge */
  .process-line {
    position: absolute;
    left: 3px;
    top: 6px;
    bottom: 6px;
    width: 1px;
    background-color: var(--color-outline);
    --line-from: scaleY(0);
    --line-origin: center top;
  }
  .process-node {
    position: absolute;
    left: -1.75rem;
    top: 5px;
    width: 7px;
    height: 7px;
    background-color: var(--color-secondary);
  }

  /* Desktop: the line runs across the top and each step hangs from a node */
  @media (min-width: 1024px) {
    .process {
      padding-left: 0;
      padding-top: 2.25rem;
    }
    .process-grid {
      grid-template-columns: repeat(var(--steps), minmax(0, 1fr));
      gap: 2.5rem;
    }
    .process-line {
      left: 0;
      right: 0;
      top: 3px;
      bottom: auto;
      width: auto;
      height: 1px;
      --line-from: scaleX(0);
      --line-origin: left center;
    }
    .process-node {
      left: 0;
      top: -2.25rem;
    }
  }

  :global(.section--ink) .process-line,
  :global(.on-dark) .process-line {
    background-color: rgb(255 255 255 / 0.28);
  }
  :global(.section--ink) .process-node,
  :global(.on-dark) .process-node {
    background-color: var(--color-secondary-fixed);
  }
  :global(.section--ink) .process-step p,
  :global(.on-dark) .process-step p {
    color: rgb(255 255 255 / 0.72);
  }
</style>
