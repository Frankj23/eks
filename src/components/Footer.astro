---
import { footerColumns } from '../data/navigation.js';
import { site } from '../data/site.js';

const year = new Date().getFullYear();
const socialDefs = [
  { label: 'LinkedIn', key: 'linkedin', d: 'M4.98 3.5a2.5 2.5 0 11-.02 5 2.5 2.5 0 01.02-5zM3 9h4v12H3zM10 9h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.78 2.5 4.78 5.76V21h-4v-5.6c0-1.34-.03-3.06-2-3.06-2 0-2.3 1.45-2.3 2.96V21h-4z' },
  { label: 'Facebook', key: 'facebook', d: 'M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.25-1.5 1.55-1.5h1.65V3.6c-.29-.04-1.27-.12-2.41-.12-2.39 0-4.02 1.46-4.02 4.13V9.9H7.5V13h2.77v8z' },
  { label: 'Instagram', key: 'instagram', d: 'M12 7.4a4.6 4.6 0 100 9.2 4.6 4.6 0 000-9.2zm0 7.6a3 3 0 110-6 3 3 0 010 6zm5.9-7.8a1.07 1.07 0 11-2.15 0 1.07 1.07 0 012.15 0zM21 8c-.05-1.4-.37-2.65-1.4-3.66C18.58 3.3 17.34 3 15.94 2.9 14.5 2.83 9.5 2.83 8.06 2.9c-1.4.06-2.63.38-3.66 1.4C3.37 5.34 3.06 6.58 3 8c-.08 1.44-.08 6.44 0 7.88.05 1.4.37 2.65 1.4 3.67 1.03 1.02 2.26 1.34 3.66 1.4 1.44.08 6.44.08 7.88 0 1.4-.06 2.64-.38 3.66-1.4 1.03-1.02 1.35-2.27 1.4-3.67.08-1.44.08-6.43 0-7.88z' },
];

// Only render icons that have a real URL configured.
const socials = socialDefs
  .filter((s) => site.social[s.key])
  .map((s) => ({ ...s, href: site.social[s.key] }));
---

<footer class="bg-primary text-white/80 mt-24">
  <div class="container-max py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
      <!-- Brand column -->
      <div>
        <p class="font-display font-bold text-lg text-secondary-fixed mb-3">
          {site.name}
        </p>
        <p class="text-sm leading-relaxed mb-5 max-w-xs">{site.tagline}</p>
        <address class="not-italic text-sm space-y-1.5">
          <p>{site.contact.address}</p>
          <p>{site.contact.region}</p>
          <p>
            <a
              href={`tel:${site.contact.phone}`}
              class="link-target hover:text-secondary-fixed transition-colors"
            >
              {site.contact.phoneDisplay}
            </a>
          </p>
          <p>
            <a
              href={`mailto:${site.contact.email}`}
              class="link-target hover:text-secondary-fixed transition-colors"
            >
              {site.contact.email}
            </a>
          </p>
        </address>
      </div>

      <!-- Link columns, generated from the same data as the header -->
      {
        footerColumns.map((col) => (
          <div>
            <p class="eyebrow text-secondary-fixed mb-4">{col.heading}</p>
            <ul class="space-y-2.5">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="link-target text-sm hover:text-secondary-fixed transition-colors"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="flex flex-col sm:flex-row items-center justify-between gap-5 mt-14 pt-8 border-t border-white/15"
    >
      <p class="text-xs text-white/60">
        © {year} {site.name}. All rights reserved.
      </p>
      <!-- TRUE circles — rounded-full is now 9999px, not 0.75rem -->
      <ul class="flex items-center gap-3">
        {
          socials.map((s) => (
            <li>
              <a
                href={s.href}
                aria-label={s.label}
                class="icon-btn rounded-full border border-white/25 hover:border-secondary-fixed hover:text-secondary-fixed"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d={s.d} />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
