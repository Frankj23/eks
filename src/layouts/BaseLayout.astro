---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { site } from '../data/site.js';

const {
  title,
  description = site.description,
  activeSection,
  noindex = false,
  // Pages that carry their own WhatsApp action (or are staff tools) can drop
  // the floating button so it never sits on top of their controls.
  hideWhatsApp = false,
} = Astro.props;

const fullTitle = title ? `${title} | ${site.name}` : `${site.name} — ${site.tagline}`;
// `build: { format: 'file' }` makes pathname end in .html, but the host
// 308-redirects those to the clean URL — so the canonical was pointing at a
// redirect and contradicting the sitemap on all 25 pages.
const cleanPath = Astro.url.pathname
  .replace(/\.html$/, '')
  .replace(/^\/index$/, '/');
const canonical = new URL(cleanPath, Astro.site ?? site.url).href;

// Social preview. twitter:card claimed summary_large_image with no image,
// so every WhatsApp/Facebook share rendered as a bare grey text card.
const ogImage = new URL('/og-image.jpg', Astro.site ?? site.url).href;

// LocalBusiness structured data — helps this rank in local search.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  description: site.description,
  url: site.url,
  telephone: site.contact.phone,
  email: site.contact.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.contact.address,
    addressLocality: 'Buea',
    addressRegion: 'South-West',
    addressCountry: 'CM',
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph / social sharing — absent from the original build -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#f6f4ee" />

    <!-- Fonts: preconnect + display=swap so text is never invisible while loading.
         Three variable files (serif display, sans text, mono labels) — the icon
         font is gone; the few icons left are inline SVG. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400..500;1,6..72,400..500&family=Geist:wght@400..600&family=Geist+Mono:wght@400..500&display=swap"
      rel="stylesheet"
    />

    <!-- Scroll reveal. Inline and in <head> so the hidden state and the code
         that lifts it can never be separated by a failed network request:
         without this script nothing is ever hidden. -->
    <script is:inline>
      (function () {
        if (!('IntersectionObserver' in window)) return;
        var root = document.documentElement;
        root.classList.add('js');
        function settle(el) {
          // Hand the element back to its own transitions (hover, press).
          el.removeAttribute('data-reveal');
          el.classList.remove('is-revealed');
        }
        function init() {
          var heard = false;
          // An observer always reports once on observe(). If it stays silent,
          // something is wrong with it — show everything rather than nothing.
          setTimeout(function () {
            if (!heard) root.classList.remove('js');
          }, 2500);
          var io = new IntersectionObserver(
            function (entries) {
              heard = true;
              var i = 0;
              entries.forEach(function (entry) {
                if (!entry.isIntersecting) return;
                var el = entry.target;
                // Elements arriving together cascade; a lone one does not wait.
                el.style.setProperty('--reveal-i', Math.min(i++, 5));
                el.classList.add('is-revealed');
                io.unobserve(el);
                if (!el.hasAttribute('data-reveal-keep')) setTimeout(settle, 1400, el);
              });
            },
            { rootMargin: '0px 0px -6% 0px', threshold: 0.05 }
          );
          document.querySelectorAll('[data-reveal]').forEach(function (el) {
            io.observe(el);
          });
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
        else init();
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to main content</a>
    <Header activeSection={activeSection} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {!hideWhatsApp && <WhatsAppButton />}
  </body>
</html>
