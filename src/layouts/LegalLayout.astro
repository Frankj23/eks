---
import BaseLayout from './BaseLayout.astro';
const { title, updated } = Astro.props;
---

<BaseLayout title={title} noindex>
  <section class="bg-primary text-white">
    <div class="container-max py-16">
      <h1 class="text-4xl font-bold mb-3">{title}</h1>
      <p class="text-white/60 text-sm">Last updated: {updated}</p>
    </div>
  </section>

  <section class="py-16">
    <div class="container-max">
      <div class="max-w-[720px] prose-legal space-y-6 text-on-surface-variant leading-relaxed">
        <slot />
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .prose-legal h2 {
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-top: 2.5rem;
    margin-bottom: 0.5rem;
  }
  .prose-legal ul { list-style: disc; padding-left: 1.4rem; }
  .prose-legal li { margin-bottom: 0.4rem; }
</style>
