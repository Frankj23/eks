---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import CTABand from '../components/CTABand.astro';
import { divisionList } from '../data/divisions.js';
import { site } from '../data/site.js';
import { Image } from 'astro:assets';
import { img } from '../data/images.js';



const principles = [
  { n: '01', title: 'Scope before solution', text: 'We will not quote a fix before we understand the problem. That sometimes costs us the fast win, and it has saved clients from paying twice.' },
  { n: '02', title: 'Everything in writing', text: 'Bills of quantities, fee schedules, engagement terms and variations — all written down and agreed before work starts, so nobody is surprised by an invoice.' },
  { n: '03', title: 'Documentation you can use', text: 'Drawings, test results, commissioning records and manuals are handed over as a matter of course. They are yours, not ours.' },
  { n: '04', title: 'Say when it is not us', text: 'If a job needs a licensed specialist or falls outside what we do well, we will say so and point you somewhere better.' },
];

const team = [
  { name: 'Ekane Junior', role: 'C.E.O & Founder', credential: 'M.TECH in Electrical Power System, EPS Lecturer & Tutor, Renewable Energy Expert.', image: 'team-founder' },
  { name: 'Idriss Parfait', role: 'General Manager', credential: 'BSc Finance, MBA Finance', image: 'team-finance-head' },
  { name: 'Frank Junior', role: 'Head of Computer Engineering', credential: 'B.Tech Computer Engineering, MTech Software Engineering, Lecturer and Director of ASEND Prep classes.', image: 'team-computer-head' },
  { name: 'Motale', role: 'Head of Mechatronics', credential: 'M.TECH in Mechatronics & BTech in Electrical & Electronic engineering, IOT Expert', image: 'team-Mechatronics-head' },
  { name: 'Bameh Conrad', role: 'Head of Electrical Power System', credential: 'B.Tech, B.Eng EPS, Matlab, IOT Based Engineer', image: 'team-electrical-head' },
  { name: 'Kwanyuy Daniel', role: 'Head of Networks & Security Dept', credential: 'B.Tech Computer engineering, MTech Software Engineering', image: 'team-electrical-head' },
];
---

<BaseLayout title="About Us" activeSection="company">
  <section class="bg-primary text-white">
    <div class="container-max py-20 md:py-28">
      <p class="eyebrow text-secondary-fixed mb-5">About</p>
      <h1 class="text-4xl md:text-5xl font-bold max-w-3xl leading-tight mb-6">
        One team, four disciplines, one standard.
      </h1>
      <p class="text-lg text-white/75 max-w-2xl leading-relaxed">{site.description}</p>
    </div>
  </section>

  <Section eyebrow="Our Story" title="How we got here">
    <div class="max-w-3xl space-y-5 text-lg text-on-surface-variant leading-relaxed">
      <p>
        E.K's Tech began with a problem its founders kept running into: in Cameroon,
        a single project routinely needs four different firms. The structural design
        comes from one office, the electrical work from another, the land paperwork
        from a third, and the financial plan from a fourth — none of whom talk to
        each other, and all of whom blame the others when something slips.
      </p>
      <p>
        We built the practice the other way round. Four divisions, one team, one
        point of contact. When a property development needs a structural review, a
        power design, a title check and a funding model, that is one conversation
        here rather than four contracts and three months of coordination.
      </p>
      <p>
        The engineering side came first and still sets the standard for everything
        else: scope the problem before proposing a solution, put the numbers in
        writing, and hand over documentation the client can actually use. Academic
        Services grew out of the same instinct — the students we supervised on
        placement needed the same rigour, and too few were getting it.
      </p>
    </div>
  </Section>

  <Section alt eyebrow="Why It Matters" title="Four divisions that actually talk to each other"
    intro="Most firms hand you off. A property project needs structural engineering, financial modelling and project management — here that is one conversation, not three contracts.">
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6">
      {divisionList.map((d) => (
        <article class="bg-surface border border-outline-variant rounded-lg p-7">
          <h3 class="font-semibold text-primary mb-2">{d.name}</h3>
          <p class="text-sm text-on-surface-variant leading-relaxed mb-4">{d.cardBlurb}</p>
          <a href={`/${d.slug}`} class="eyebrow text-secondary">Explore →</a>
        </article>
      ))}
    </div>
  </Section>

  <Section eyebrow="How We Work" title="Four commitments that hold across every division"
    intro="These are the things we will not trade away for a faster close or an easier quote.">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-4">
      {principles.map((pr) => (
        <article class="bg-surface border border-outline-variant rounded-lg p-7">
          <p class="stat-figure text-2xl text-secondary-fixed mb-3">{pr.n}</p>
          <h3 class="font-semibold text-primary mb-2">{pr.title}</h3>
          <p class="text-[15px] text-on-surface-variant leading-relaxed">{pr.text}</p>
        </article>
      ))}
    </div>
  </Section>

  <Section alt eyebrow="Leadership" title="Who you will work with"
    intro="Small enough that the person who scopes your project is the person who runs it.">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {team.map((m) => (
        <article class="text-center">
          <!-- TRUE circle — the radius token is fixed -->
          {img(m.image) ? (
            <Image
              src={img(m.image).src}
              alt={img(m.image).alt}
              width={112}
              height={112}
              class="w-28 h-28 rounded-full object-cover mx-auto mb-5"
            />
          ) : (
            <div class="w-28 h-28 rounded-full bg-surface-container-low border border-outline-variant mx-auto mb-5 flex items-center justify-center">
              <span class="material-symbols-outlined text-4xl text-on-surface-variant" aria-hidden="true">person</span>
            </div>
          )}
          <h3 class="font-semibold text-primary">{m.name}</h3>
          <p class="text-sm text-secondary mt-1">{m.role}</p>
          <p class="text-sm text-on-surface-variant mt-2">{m.credential}</p>
        </article>
      ))}
    </div>
  </Section>

  <Section eyebrow="Find Us" title="Our office">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-start">
      <address class="not-italic text-lg space-y-2">
        <p>{site.contact.address}</p>
        <p>{site.contact.region}</p>
        <p><a href={`tel:${site.contact.phone}`} class="hover:text-secondary transition-colors">{site.contact.phoneDisplay}</a></p>
        <p><a href={`mailto:${site.contact.email}`} class="hover:text-secondary transition-colors">{site.contact.email}</a></p>
      </address>
      <div class="aspect-video bg-surface border border-outline-variant rounded-lg overflow-hidden rounded-lg">
        <iframe
          src="https://www.google.com/maps?q=Buea,+Cameroon&z=14&output=embed"
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </Section>

  <CTABand />
</BaseLayout>