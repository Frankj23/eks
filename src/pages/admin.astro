      const toggleBtn = node.querySelector('.row-toggle');
      toggleBtn.textContent = published ? 'Unpublish' : 'Publish';
      toggleBtn.setAttribute('aria-label', `${toggleBtn.textContent} ${project.title}`);
      toggleBtn.addEventListener('click', () =>
        runRowAction(toggleBtn, () => togglePublish(project), `Could not update “${project.title}”`)
