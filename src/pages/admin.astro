      const editBtn = node.querySelector('.row-edit');
      editBtn.setAttribute('aria-label', `Edit ${project.title}`);
      editBtn.addEventListener('click', () => fillForm(project));

      const deleteBtn = node.querySelector('.row-delete');
      deleteBtn.setAttribute('aria-label', `Delete ${project.title}`);
      deleteBtn.addEventListener('click', () =>
        runRowAction(deleteBtn, () => removeProject(project), `Could not delete “${project.title}”`)
      );

      tableEl.appendChild(node);
    }
    markEditing();
  }

  async function load() {
    try {
      projects = await fetchAllProjects();
      renderTable();
    } catch (err) {
      statusEl.textContent = `Could not load projects: ${err.message}`;
      countEl.textContent = '';
      showNote(
        statusEl.textContent,
        'Check your connection and that you are still signed in, then try again.',
        true
      );
    }
  }

  async function togglePublish(project) {
    const nextStatus = project.status === 'published' ? 'draft' : 'published';
    await updateProject(project.id, { status: nextStatus });
    await load();
  }

  async function removeProject(project) {
    if (!confirm(`Delete "${project.title}"? This cannot be undone.`)) return;
    await deleteProject(project.id);
    if (editingId === project.id) resetForm();
    await load();
  }

  photosInput.addEventListener('change', async () => {
    const files = Array.from(photosInput.files || []);
    photosInput.disabled = true;
    try {
      for (const file of files) {
        const { key } = await uploadPhoto(file);
        pendingImageKeys.push(key);
        previewsEl.appendChild(previewFrame(URL.createObjectURL(file)));
      }
    } catch (err) {
      formError.textContent = `Photo upload failed: ${err.message}`;
      formError.classList.remove('hidden');
    } finally {
      photosInput.value = '';
      photosInput.disabled = false;
    }
  });

  document.getElementById('new-project-btn').addEventListener('click', () => {
    resetForm();
    revealForm();
  });
  cancelBtn.addEventListener('click', resetForm);
  form.addEventListener('input', () => formSuccess.classList.add('hidden'));

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    formError.classList.add('hidden');
    formSuccess.classList.add('hidden');

    const data = new FormData(form);
    const payload = {
      title: data.get('title'),
      slug: data.get('slug') || slugify(data.get('title')),
      domain: data.get('domain'),
      location: data.get('location') || null,
      client: data.get('client') || null,
      completed_on: data.get('completed_on') || null,
      scope: data.get('scope'),
      description: data.get('description'),
      capabilities: (data.get('capabilities') || '')
        .split(',')
        .map((c) => c.trim())
        .filter(Boolean),
      images: pendingImageKeys,
      status: data.get('status'),
    };

    // Hold the button's width so the shorter label does not shift Cancel.
    saveBtn.style.minWidth = `${saveBtn.offsetWidth}px`;
    saveBtn.disabled = true;
    saveBtn.setAttribute('aria-busy', 'true');
    saveBtn.textContent = 'Saving…';
    try {
      if (editingId) await updateProject(editingId, payload);
      else await createProject(payload);
      resetForm();
      formSuccess.textContent = `Saved “${payload.title}”.`;
      formSuccess.classList.remove('hidden');
      load();
    } catch (err) {
      formError.textContent = err.message;
      formError.classList.remove('hidden');
    } finally {
      saveBtn.disabled = false;
      saveBtn.removeAttribute('aria-busy');
      saveBtn.textContent = saveLabel;
    }
  });

  load();
</script>

