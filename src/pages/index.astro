---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import CTABand from '../components/CTABand.astro';
import { Image } from 'astro:assets';
import { divisionList } from '../data/divisions.js';
import { img } from '../data/images.js';
import { site } from '../data/site.js';

const heroImg = img('project-bridge');

const differentiators = [
  {
    n: '01',
    title: 'One team, not four contracts',
    text: 'A property build needs structural design, a power system, a title check and a funding model. Here that is one conversation and one point of contact, instead of four firms blaming each other.',
  },
  {
    n: '02',
    title: 'Priced from a bill of quantities',
    text: 'Every quote is broken down line by line — materials, labour, plant, contingency. You see what each figure covers before you commit, and the price holds unless scope genuinely changes.',
  },
  {
    n: '03',
    title: 'Engineering discipline everywhere',
    text: 'The same standard the engineering division works to carries into property and finance: scope the problem first, put the assumptions in writing, hand over documentation you can actually use.',
  },
  {
    n: '04',
    title: 'We say when it is not us',
    text: 'If a job needs a licensed specialist or sits outside what we do well, we will tell you and point you somewhere better. A referral costs us a fee; a bad delivery costs us a reputation.',
  },
];

const engagement = [
  { title: 'First conversation', text: 'Tell us the problem. We work out which division — or divisions — it belongs to, at no cost.' },
  { title: 'Scope & written quote', text: 'A site visit or document review where needed, then a scoped proposal with the numbers broken out.' },
  { title: 'Delivery', text: 'Work proceeds against the agreed scope with documented progress, and variations only ever in writing.' },
  { title: 'Handover & support', text: 'Testing, documentation and a proper handover — plus maintenance or advisory support if you want it.' },
];

const sectors = [
  'Commercial & Retail',
  'Residential Development',
  'Industrial & Manufacturing',
  'Education & Institutions',
  'Agriculture & Agro-processing',
  'Small & Growing Businesses',
];
---

<BaseLayout title={null}>
  <!-- HERO -->
  <section class="relative bg-primary text-white overflow-hidden">
    <Image src={heroImg.src} alt={heroImg.alt} widths={[640, 1024, 1920]} sizes="100vw"
      loading="eager" fetchpriority="high"
      class="absolute inset-0 w-full h-full object-cover opacity-30" />
    <div class="absolute inset-0 bg-gradient-to-br from-primary via-primary/92 to-primary/50" aria-hidden="true"></div>
    <div class="container-max py-24 md:py-32 relative">
      <p class="eyebrow text-secondary-fixed mb-5">Multi-Disciplinary Firm</p>
      <h1 class="text-4xl md:text-6xl font-bold max-w-4xl leading-[1.1] mb-6">
        Engineering, Academic, Property and Finance — under one roof.
      </h1>
      <p class="text-lg md:text-xl text-white/75 max-w-2xl mb-10 leading-relaxed">
        {site.name} brings engineering discipline to four connected practices, so a
        single team can take a project from technical design through to financial planning.
      </p>
      <div class="flex flex-wrap gap-4">
        <a href="/contact" class="btn-gold">Start a Conversation</a>
        <a href="/portfolio" class="btn-secondary !text-white !border-white/30 hover:!border-secondary-fixed hover:!text-secondary-fixed">
          View Our Work
        </a>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="bg-primary-container text-white border-t border-white/10">
    <div class="container-max grid grid-cols-2 lg:grid-cols-4 gap-8 py-12">
      {site.stats.map((s) => (
        <div>
          <p class="font-display text-3xl md:text-4xl font-bold text-secondary-fixed">{s.value}</p>
          <p class="text-sm text-white/70 mt-1">{s.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- FOUR DIVISIONS -->
  <Section
    eyebrow="What We Do"
    title="One Company. Four Areas of Expertise."
    intro="Each division stands on its own — and together they cover a project from first drawing to final balance sheet."
  >
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6">
      {divisionList.map((d) => (
        <article class="card overflow-hidden flex flex-col">
          {img(d.hero) && (
            <Image src={img(d.hero).src} alt={img(d.hero).alt} widths={[320, 640]}
              sizes="(min-width: 1280px) 25vw, (min-width: 768px) 50vw, 100vw"
              loading="lazy" class="w-full aspect-[3/2] object-cover" />
          )}
          <div class="p-7 flex flex-col grow">
          <span class="material-symbols-outlined w-12 h-12 rounded-lg bg-primary-container text-white flex items-center justify-center text-2xl mb-5" aria-hidden="true">
            {d.icon}
          </span>
          <h3 class="text-xl font-semibold text-primary mb-3">{d.name}</h3>
          <p class="text-on-surface-variant text-[15px] leading-relaxed grow">{d.cardBlurb}</p>
          <a href={`/${d.slug}`} class="card-cta eyebrow mt-6">
            Explore {d.name} <span aria-hidden="true">→</span>
          </a>
          </div>
        </article>
      ))}
    </div>
  </Section>

  <!-- WHY US — the "proof" beat the page was missing between what-we-do and the CTA -->
  <Section
    alt
    eyebrow="Why E.K's Tech"
    title="What you actually get when you hire us"
    intro="Four things we hold to on every engagement, in every division."
  >
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6">
      {differentiators.map((d) => (
        <article class="bg-surface border border-outline-variant rounded-lg p-7 flex flex-col">
          <span class="stat-figure text-2xl text-secondary mb-4">{d.n}</span>
          <h3 class="text-lg font-semibold text-primary mb-3">{d.title}</h3>
          <p class="text-[15px] text-on-surface-variant leading-relaxed grow">{d.text}</p>
        </article>
      ))}
    </div>
  </Section>

  <!-- HOW AN ENGAGEMENT RUNS -->
  <Section
    eyebrow="How It Works"
    title="From first call to handover"
    intro="The same four stages whichever division you come through, so you always know where a project stands."
  >
    <ol class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {engagement.map((s, i) => (
        <li class="relative bg-surface border border-outline-variant rounded-lg p-7">
          <span class="stat-figure text-3xl text-secondary-fixed block mb-3">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3 class="font-semibold text-primary mb-2">{s.title}</h3>
          <p class="text-sm text-on-surface-variant leading-relaxed">{s.text}</p>
        </li>
      ))}
    </ol>
  </Section>

  <!-- SECTORS -->
  <Section alt eyebrow="Who We Work With" title="Sectors we serve">
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
      {sectors.map((s) => (
        <div class="bg-surface border border-outline-variant rounded-lg px-4 py-6 text-center">
          <p class="text-sm font-semibold text-primary leading-snug">{s}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- ROUTER BAND -->
  <Section title="Not sure which division you need?" intro="Tell us the problem and we will route you to the right team — most projects touch more than one.">
    <div class="flex flex-wrap gap-3">
      {divisionList.map((d) => (
        <a href={`/${d.slug}`} class="btn-secondary bg-surface">{d.name}</a>
      ))}
    </div>
  </Section>

  <CTABand />
</BaseLayout>
