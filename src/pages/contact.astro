---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import { divisionList } from '../data/divisions.js';
import { site } from '../data/site.js';
---

<BaseLayout title="Contact" description={`Get in touch with ${site.name} — engineering, academic, real estate and finance services in Buea, Cameroon.`}>
  <section class="bg-primary text-white">
    <div class="container-max py-20">
      <h1 class="text-4xl md:text-5xl font-bold mb-5">Contact Us</h1>
      <p class="text-lg text-white/75 max-w-2xl">
        Tell us what you need. If you are not sure which division handles it, choose
        "Not sure" and we will route your enquiry.
      </p>
    </div>
  </section>

  <Section>
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-14">
      <!-- FORM -->
      <div class="lg:col-span-3">
        <!--
          SETUP: replace YOUR_ACCESS_KEY with a free key from https://web3forms.com
          Hostinger shared hosting can send PHP mail, but deliverability is poor —
          a form service or authenticated SMTP is far more reliable.
        -->
        <form id="contact-form" action="https://api.web3forms.com/submit" method="POST" class="space-y-6">
          <input type="hidden" name="access_key" value="YOUR_ACCESS_KEY" />
          <input type="hidden" name="subject" value="New enquiry from ekstech.com" />
          <!-- Honeypot spam trap -->
          <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

          <div>
            <label for="topic" class="eyebrow text-on-surface-variant block mb-2">
              What do you need help with? <span class="text-secondary">*</span>
            </label>
            <select id="topic" name="topic" required
              class="w-full border border-outline-variant rounded bg-surface px-4 py-3 text-[15px] focus:border-primary outline-none transition-colors">
              <option value="">Select a division…</option>
              {divisionList.map((d) => <option value={d.name}>{d.name}</option>)}
              <option value="Not sure">Not sure</option>
            </select>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label for="name" class="eyebrow text-on-surface-variant block mb-2">
                Full name <span class="text-secondary">*</span>
              </label>
              <input id="name" name="name" type="text" required autocomplete="name"
                class="w-full border border-outline-variant rounded bg-surface px-4 py-3 text-[15px] focus:border-primary outline-none transition-colors" />
            </div>
            <div>
              <label for="email" class="eyebrow text-on-surface-variant block mb-2">
                Email <span class="text-secondary">*</span>
              </label>
              <input id="email" name="email" type="email" required autocomplete="email"
                class="w-full border border-outline-variant rounded bg-surface px-4 py-3 text-[15px] focus:border-primary outline-none transition-colors" />
            </div>
          </div>

          <div>
            <label for="phone" class="eyebrow text-on-surface-variant block mb-2">Phone / WhatsApp</label>
            <input id="phone" name="phone" type="tel" autocomplete="tel"
              class="w-full border border-outline-variant rounded bg-surface px-4 py-3 text-[15px] focus:border-primary outline-none transition-colors" />
          </div>

          <div>
            <label for="message" class="eyebrow text-on-surface-variant block mb-2">
              Message <span class="text-secondary">*</span>
            </label>
            <textarea id="message" name="message" rows="6" required
              class="w-full border border-outline-variant rounded bg-surface px-4 py-3 text-[15px] focus:border-primary outline-none transition-colors resize-y"></textarea>
          </div>

          <button type="submit" class="btn-primary">Send Enquiry</button>

          <p id="form-status" role="status" aria-live="polite" class="text-sm hidden"></p>
        </form>
      </div>

      <!-- DETAILS -->
      <aside class="lg:col-span-2 space-y-8">
        <div class="bg-surface-container-low rounded-lg p-7">
          <p class="eyebrow text-secondary mb-4">Reach us directly</p>
          <address class="not-italic space-y-4 text-[15px]">
            <p>
              <span class="block text-xs uppercase tracking-wider text-on-surface-variant mb-1">Office</span>
              {site.contact.address}<br />{site.contact.region}
            </p>
            <p>
              <span class="block text-xs uppercase tracking-wider text-on-surface-variant mb-1">Phone</span>
              <a href={`tel:${site.contact.phone}`} class="hover:text-secondary transition-colors">{site.contact.phoneDisplay}</a>
            </p>
            <p>
              <span class="block text-xs uppercase tracking-wider text-on-surface-variant mb-1">Email</span>
              <a href={`mailto:${site.contact.email}`} class="hover:text-secondary transition-colors">{site.contact.email}</a>
            </p>
          </address>
          <a href={`https://wa.me/${site.contact.whatsapp}`} target="_blank" rel="noopener noreferrer" class="btn-secondary w-full mt-6">
            Message on WhatsApp
          </a>
        </div>

        <div>
          <p class="eyebrow text-secondary mb-4">Go straight to a division</p>
          <ul class="space-y-2.5">
            {divisionList.map((d) => (
              <li>
                <a href={`/${d.slug}`} class="text-[15px] hover:text-secondary transition-colors">{d.name} →</a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </Section>
</BaseLayout>

<script define:vars={{ fallbackEmail: site.contact.email }}>
  const form = document.getElementById('contact-form');
  const status = document.getElementById('form-status');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status) return;
    status.className = 'text-sm text-on-surface-variant';
    status.textContent = 'Sending…';

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (res.ok) {
        status.className = 'text-sm text-tertiary font-medium';
        status.textContent = 'Thank you — your enquiry has been sent. We will respond shortly.';
        form.reset();
      } else {
        throw new Error('Request failed');
      }
    } catch {
      status.className = 'text-sm text-red-700 font-medium';
      status.textContent = `Something went wrong. Please email us directly at ${fallbackEmail}.`;
    }
  });
</script>
