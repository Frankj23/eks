---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import { divisionList } from '../data/divisions.js';
import { site } from '../data/site.js';

// One definition, five fields. text-base (16px) is deliberate: iOS Safari
// auto-zooms any input under 16px, which jerked the layout on every focus.
const field =
  'w-full border border-outline-variant rounded bg-surface px-4 py-3 text-base ' +
  'min-h-[44px] focus:border-primary outline-none transition-colors';
---

<BaseLayout title="Contact" description={`Get in touch with ${site.name} — engineering, academic, real estate and finance services in Buea, Cameroon.`}>
  <section class="bg-primary text-white">
    <div class="container-max py-20">
      <h1 class="text-4xl md:text-5xl font-bold mb-5">Contact Us</h1>
      <p class="text-lg text-white/75 max-w-2xl">
        Tell us what you need. If you are not sure which division handles it, choose
        "Not sure" and we will route your enquiry.
      </p>
    </div>
  </section>

  <Section>
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-14">
      <!-- FORM -->
      <div class="lg:col-span-3">
        <!--
          SETUP: the access key lives in src/data/site.js (`formAccessKey`).
          Until it holds a real key from https://web3forms.com every submit fails,
          and the script below falls back to a prefilled email / WhatsApp handoff
          so the enquiry is not silently lost.
        -->
        <form id="contact-form" action="https://api.web3forms.com/submit" method="POST" class="space-y-6">
          <input type="hidden" name="access_key" value={site.formAccessKey} />
          <input type="hidden" name="subject" value="New enquiry from ekstechub.com" />
          <!-- Honeypot spam trap -->
          <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

          <div>
            <label for="topic" class="eyebrow text-on-surface-variant block mb-2">
              What do you need help with? <span class="text-secondary">*</span>
            </label>
            <select id="topic" name="topic" required
              class={field}>
              <option value="">Select a division…</option>
              {divisionList.map((d) => <option value={d.name}>{d.name}</option>)}
              <option value="Not sure">Not sure</option>
            </select>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label for="name" class="eyebrow text-on-surface-variant block mb-2">
                Full name <span class="text-secondary">*</span>
              </label>
              <input id="name" name="name" type="text" required autocomplete="name"
                class={field} />
            </div>
            <div>
              <label for="email" class="eyebrow text-on-surface-variant block mb-2">
                Email <span class="text-secondary">*</span>
              </label>
              <input id="email" name="email" type="email" required autocomplete="email"
                class={field} />
            </div>
          </div>

          <div>
            <label for="phone" class="eyebrow text-on-surface-variant block mb-2">Phone / WhatsApp</label>
            <input id="phone" name="phone" type="tel" inputmode="tel" autocomplete="tel"
              class={field} />
          </div>

          <div>
            <label for="message" class="eyebrow text-on-surface-variant block mb-2">
              Message <span class="text-secondary">*</span>
            </label>
            <textarea id="message" name="message" rows="6" required
              class={`${field} resize-y`}></textarea>
          </div>

          <button id="form-submit" type="submit" class="btn-primary">Send Enquiry</button>

          <p id="form-status" role="status" aria-live="polite" class="form-status text-sm hidden"></p>
        </form>
      </div>

      <!-- DETAILS -->
      <aside class="lg:col-span-2 space-y-8">
        <div class="bg-surface-container-low rounded-lg p-7">
          <p class="eyebrow text-secondary mb-4">Reach us directly</p>
          <address class="not-italic space-y-4 text-[15px]">
            <p>
              <span class="block text-xs uppercase tracking-wider text-on-surface-variant mb-1">Office</span>
              {site.contact.address}<br />{site.contact.region}
            </p>
            <p>
              <span class="block text-xs uppercase tracking-wider text-on-surface-variant mb-1">Phone</span>
              <a href={`tel:${site.contact.phone}`} class="link-target hover:text-secondary transition-colors">{site.contact.phoneDisplay}</a>
            </p>
            <p>
              <span class="block text-xs uppercase tracking-wider text-on-surface-variant mb-1">Email</span>
              <a href={`mailto:${site.contact.email}`} class="link-target hover:text-secondary transition-colors">{site.contact.email}</a>
            </p>
          </address>
          <a href={`https://wa.me/${site.contact.whatsapp}`} target="_blank" rel="noopener noreferrer" class="btn-secondary w-full mt-6">
            Message on WhatsApp
          </a>
        </div>

        <div>
          <p class="eyebrow text-secondary mb-4">Go straight to a division</p>
          <ul class="space-y-2.5">
            {divisionList.map((d) => (
              <li>
                <a href={`/${d.slug}`} class="link-target text-[15px] hover:text-secondary transition-colors">{d.name} →</a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </Section>
</BaseLayout>

<style>
  /* The one conversion moment on the site — don't let the result teleport in. */
  .form-status:not(.hidden) {
    animation: status-in 220ms var(--ease-emphasized);
  }
  @keyframes status-in {
    from { opacity: 0; transform: translateY(-4px); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>

<script define:vars={{ fallbackEmail: site.contact.email, whatsapp: site.contact.whatsapp }}>
  const form = document.getElementById('contact-form');
  const status = document.getElementById('form-status');
  const submit = document.getElementById('form-submit');
  const submitLabel = submit?.textContent;

  // Builds the text of the enquiry so a failed POST can hand it to the user's
  // mail client or WhatsApp instead of losing it.
  function composeEnquiry(data) {
    return [
      `Division: ${data.get('topic') || '—'}`,
      `Name: ${data.get('name') || '—'}`,
      `Email: ${data.get('email') || '—'}`,
      `Phone: ${data.get('phone') || '—'}`,
      '',
      data.get('message') || '',
    ].join('\n');
  }

  // Reassigning className would drop `form-status` and kill the entrance, and
  // reusing the same animation name never restarts it — hence the reflow.
  function setStatus(tone, content, isHTML) {
    if (!status) return;
    status.className = `form-status text-sm ${tone}`;
    void status.offsetWidth;
    if (isHTML) status.innerHTML = content;
    else status.textContent = content;
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status) return;

    const data = new FormData(form);

    // Pending state — without this a slow connection is indistinguishable
    // from a dead button.
    if (submit) {
      submit.disabled = true;
      submit.textContent = 'Sending…';
      submit.style.opacity = '0.65';
    }
    setStatus('text-on-surface-variant', 'Sending…');

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: data,
        headers: { Accept: 'application/json' },
      });
      if (res.ok) {
        setStatus('text-tertiary font-medium',
          'Thank you — your enquiry has been sent. We will respond shortly.');
        form.reset();
      } else {
        throw new Error('Request failed');
      }
    } catch {
      // Don't drop the enquiry. Offer both handoffs, prefilled.
      const body = composeEnquiry(data);
      const mailto = `mailto:${fallbackEmail}?subject=${encodeURIComponent('Website enquiry')}&body=${encodeURIComponent(body)}`;
      const wa = `https://wa.me/${whatsapp}?text=${encodeURIComponent(body)}`;

      setStatus('text-red-700 font-medium',
        'We could not send that automatically. Your message is saved below — ' +
        `<a class="underline" href="${mailto}">send it by email</a> or ` +
        `<a class="underline" href="${wa}" target="_blank" rel="noopener noreferrer">send it on WhatsApp</a>.`,
        true);
    } finally {
      if (submit) {
        submit.disabled = false;
        submit.textContent = submitLabel;
        submit.style.opacity = '';
      }
    }
  });
</script>
