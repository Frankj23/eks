---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import { divisions } from '../../data/divisions.js';

const steps = divisions.academic.process;

// Confirm these against the firm's actual intake policy before each cycle.
const eligibility = [
  'Currently enrolled at a recognised Cameroonian institution in engineering or applied science — HTTTC, the Faculty of Engineering and Technology, COT and equivalent programmes all qualify.',
  'Studying at HND, B.Tech, B.Eng or M.Tech level. First-year students are welcome to apply for project support, but site placements are reserved for those who have completed at least one year of core coursework.',
  'Able to demonstrate the fundamentals for your stream — circuit theory and machines for electrical, statics and materials for civil, programming and digital systems for computer engineering.',
  'A letter from your department or supervisor confirming enrolment and, where the placement counts toward your programme, that it will be credited.',
  'A copy of your student ID and your most recent transcript or results slip.',
  'Available for the full duration of the placement. Partial attendance cannot be assessed or certified.',
]

// What the firm commits to in return — an application page that only lists
// demands reads as one-sided.
const weProvide = [
  { title: 'A named supervisor', text: 'One engineer responsible for your placement from day one, not a rotating pool.' },
  { title: 'Real project work', text: 'You work on live engagements under supervision — not observation, and not filing.' },
  { title: 'Structured review', text: 'Scheduled check-ins against agreed objectives, with written feedback you can act on.' },
  { title: 'Formal certification', text: 'An assessed certificate and, where earned, a reference letter you can use.' },
];
---

<BaseLayout title="Eligibility & How to Apply — Academic Services" activeSection="academic"
  description="Who can apply for an E.K's Tech internship placement or project supervision, and how the process works.">
  <section class="bg-primary text-white">
    <div class="container-max py-20">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex items-center gap-2 eyebrow text-white/50">
          <li><a href="/" class="hover:text-secondary-fixed transition-colors">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/academic" class="hover:text-secondary-fixed transition-colors">Academic</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-secondary-fixed">How to Apply</li>
        </ol>
      </nav>
      <h1 class="text-4xl md:text-5xl font-bold mb-5">Eligibility & How to Apply</h1>
      <p class="text-lg text-white/75 max-w-2xl">
        What you need before you apply, and what happens after you do.
      </p>
    </div>
  </section>

  <Section eyebrow="Requirements" title="Who can apply"
    intro="If you meet most of these but not all, apply anyway and say so in your message. We would rather read your case than have you rule yourself out.">
    <ul class="max-w-3xl space-y-4">
      {eligibility.map((e) => (
        <li class="flex items-start gap-3 bg-surface border border-outline-variant rounded-lg p-5">
          <span class="text-secondary mt-0.5" aria-hidden="true">▪</span>
          <span class="text-[15px] leading-relaxed">{e}</span>
        </li>
      ))}
    </ul>
  </Section>

  <Section alt eyebrow="The Process" title="Four steps from application to certificate">
    <ol class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {steps.map((s, i) => (
        <li class="bg-surface border border-outline-variant rounded-lg p-7">
          <span class="font-display text-3xl font-bold text-secondary-fixed block mb-3">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3 class="font-semibold text-primary mb-2">{s.title}</h3>
          <p class="text-sm text-on-surface-variant leading-relaxed">{s.text}</p>
        </li>
      ))}
    </ol>
  </Section>

  <Section eyebrow="What You Get" title="What we commit to in return">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {weProvide.map((w) => (
        <article class="card p-7">
          <h3 class="font-semibold text-primary mb-2">{w.title}</h3>
          <p class="text-sm text-on-surface-variant leading-relaxed">{w.text}</p>
        </article>
      ))}
    </div>
  </Section>

  <Section alt eyebrow="Apply" title="Submit your application">
    <p class="text-lg text-on-surface-variant max-w-2xl mb-8">
      Use the contact form and select "Academic Services" as your division. Include
      your institution, level of study and area of interest.
    </p>
    <a href="/contact" class="btn-primary">Start Your Application</a>
    <p class="text-sm text-on-surface-variant mt-6 max-w-2xl">
      We read every application and reply either way. If you have not heard from us
      within ten working days, follow up — it means something went astray, not that
      you were rejected quietly.
    </p>
  </Section>
</BaseLayout>
